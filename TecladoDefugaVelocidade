local StageDropdown = nil
local StageValues = {}

local function UpdateStageList()
    StageValues = {}
    local Checkpoints = workspace:FindFirstChild("Checkpoints")
    if Checkpoints then
        local Spawns = Checkpoints:FindFirstChild("Spawns")
        if Spawns then
            for _, obj in ipairs(Spawns:GetChildren()) do
                if obj:IsA("BasePart") or obj:IsA("Model") then
                    table.insert(StageValues, obj.Name)
                end
            end
        end
    end
    
    table.sort(StageValues, function(a, b)
        local numA = tonumber(a:match("%d+"))
        local numB = tonumber(b:match("%d+"))
        if numA and numB then
            return numA < numB
        end
        return a < b
    end)
    
    if StageDropdown then
        StageDropdown:SetValues(StageValues)
    end
end

StageDropdown = TpStageGroup:AddDropdown("StageDropdown", {
    Values = StageValues,
    Text = "Selecionar Stage",
    Tooltip = "Escolha um spawn para teleportar"
})

local TpStageButton = TpStageGroup:AddButton({
    Text = "Teleportar para Stage",
    Tooltip = "Teleporta para o stage selecionado",
    Func = function()
        if not StageDropdown or not StageDropdown.Value then
            Library:Notify("Nenhum stage selecionado!", 2)
            return
        end
        
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        if not LocalPlayer.Character then return end
        if not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
        
        local Checkpoints = workspace:FindFirstChild("Checkpoints")
        if not Checkpoints then
            Library:Notify("Checkpoints nao encontrado!", 2)
            return
        end
        
        local Spawns = Checkpoints:FindFirstChild("Spawns")
        if not Spawns then
            Library:Notify("Spawns nao encontrado!", 2)
            return
        end
        
        local TargetStage = Spawns:FindFirstChild(StageDropdown.Value)
        if not TargetStage then
            Library:Notify("Stage nao encontrado!", 2)
            return
        end
        
        local TargetPos
        if TargetStage:IsA("BasePart") then
            TargetPos = TargetStage.CFrame.Position
        elseif TargetStage:IsA("Model") and TargetStage.PrimaryPart then
            TargetPos = TargetStage.PrimaryPart.CFrame.Position
        elseif TargetStage:IsA("Model") then
            for _, child in ipairs(TargetStage:GetDescendants()) do
                if child:IsA("BasePart") then
                    TargetPos = child.CFrame.Position
                    break
                end
            end
        end
        
        if TargetPos then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(TargetPos + Vector3.new(0, 5, 0))
            Library:Notify("Teleportado para: " .. StageDropdown.Value, 2)
        else
            Library:Notify("Nao foi possivel obter posicao do stage!", 2)
        end
    end
})

