-- ============================================
-- FLY ESTILO INFINITE YIELD - FLUTUANDO NO AR
-- ============================================
-- Diferenca do anterior: NAO usa PlatformStand!
-- BodyVelocity com MaxForce alta vence a gravidade naturalmente
-- Personagem fica "vivo" e flutuando, nao parado no chao

local function StartFly()
    if not LocalPlayer.Character then return end
    if not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    if not LocalPlayer.Character:FindFirstChild("Humanoid") then return end
    
    local HRP = LocalPlayer.Character.HumanoidRootPart
    local Hum = LocalPlayer.Character.Humanoid
    
    -- NAO usar PlatformStand! Manter humanoid normal
    -- O BodyVelocity com MaxForce 9e9 vence a gravidade
    
    -- Criar BodyGyro (mantem orientacao suave)
    FlyBodyGyro = Instance.new("BodyGyro")
    FlyBodyGyro.P = 9e4
    FlyBodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    FlyBodyGyro.CFrame = HRP.CFrame
    FlyBodyGyro.Parent = HRP
    
    -- Criar BodyVelocity (movimento + anti-gravidade)
    FlyBodyVelocity = Instance.new("BodyVelocity")
    FlyBodyVelocity.Velocity = Vector3.new(0, 0.1, 0) -- Pequena velocidade Y para flutuar
    FlyBodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9) -- Forca maxima em TODOS eixos
    FlyBodyVelocity.Parent = HRP
    
    if FlyConnection then FlyConnection:Disconnect() end
    
    FlyConnection = RunService.Heartbeat:Connect(function()
        if not FlyEnabled then return end
        if not LocalPlayer.Character then return end
        if not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
        if not LocalPlayer.Character:FindFirstChild("Humanoid") then return end
        
        local HRP = LocalPlayer.Character.HumanoidRootPart
        local Hum = LocalPlayer.Character.Humanoid
        local CamCF = Camera.CFrame
        
        -- Calcular direcao de movimento baseada na camera
        local MoveDir = Vector3.new(0, 0, 0)
        
        -- WASD - segue a camera (incluindo cima/baixo)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            MoveDir = MoveDir + CamCF.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            MoveDir = MoveDir - CamCF.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            MoveDir = MoveDir - CamCF.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            MoveDir = MoveDir + CamCF.RightVector
        end
        
        -- ESPACO sobe
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            MoveDir = MoveDir + Vector3.new(0, 1, 0)
        end
        
        -- LEFT SHIFT desce
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            MoveDir = MoveDir - Vector3.new(0, 1, 0)
        end
        
        -- Aplicar velocidade
        if MoveDir.Magnitude > 0 then
            MoveDir = MoveDir.Unit * FlySpeed
        else
            -- Flutuando parado no ar - pequena velocidade pra cima pra contragravidade
            MoveDir = Vector3.new(0, 0.1, 0)
        end
        
        -- Aplicar ao BodyVelocity
        if FlyBodyVelocity then
            FlyBodyVelocity.Velocity = MoveDir
        end
        
        -- Atualizar BodyGyro para seguir camera (suave)
        if FlyBodyGyro then
            FlyBodyGyro.CFrame = CFrame.new(HRP.Position, HRP.Position + CamCF.LookVector * Vector3.new(1, 0, 1))
        end
    end)
    
    print("[Fly] Flutuando no ar | Velocidade: " .. FlySpeed)
    print("[Fly] W/A/S/D segue camera | Espaco sobe | Shift desce")
end

local function StopFly()
    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end
    
    -- Destruir BodyMovers
    if FlyBodyGyro then
        FlyBodyGyro:Destroy()
        FlyBodyGyro = nil
    end
    
    if FlyBodyVelocity then
        FlyBodyVelocity:Destroy()
        FlyBodyVelocity = nil
    end
    
    print("[Fly] Parado - caindo...")
end

-- ============================================
-- ESP CORRIGIDO - Loop continuo + respawn
-- ============================================
local function CreateEspForPlayer(player)
    if player == LocalPlayer then return end
    
    local function SetupCharacter(character)
        if not character then return end
        
        local Head = character:WaitForChild("Head", 3)
        if not Head then 
            warn("[ESP] Head nao encontrado para " .. player.Name)
            return 
        end
        
        -- Remover ESP antigo se existir
        local OldEsp = Head:FindFirstChild("EspBillboard")
        if OldEsp then
            OldEsp:Destroy()
        end
        
        local Billboard = Instance.new("BillboardGui")
        Billboard.Name = "EspBillboard"
        Billboard.AlwaysOnTop = true
        Billboard.Size = UDim2.new(0, 120, 0, 30)
        Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        Billboard.Adornee = Head
        Billboard.Parent = Head
        
        local Label = Instance.new("TextLabel")
        Label.Name = "NameLabel"
        Label.BackgroundTransparency = 1
        Label.Size = UDim2.new(1, 0, 1, 0)
        Label.Text = player.Name
        Label.TextColor3 = Color3.fromRGB(0, 255, 100)
        Label.TextStrokeTransparency = 0.3
        Label.TextStrokeColor3 = Color3.new(0, 0, 0)
        Label.TextScaled = true
        Label.FontFace = Library.Scheme.Font
        Label.Parent = Billboard
        
        -- Atualizar cor do time
        local function UpdateTeamColor()
            if player.Team then
                Label.TextColor3 = player.TeamColor.Color
            else
                Label.TextColor3 = Color3.fromRGB(0, 255, 100)
            end
        end
        
        player:GetPropertyChangedSignal("Team"):Connect(UpdateTeamColor)
        UpdateTeamColor()
        
        EspBillboards[player] = Billboard
        
        print("[ESP] Criado para " .. player.Name)
    end
    
    -- Conectar CharacterAdded para respawns
    local charConn = player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        if EspEnabled then
            SetupCharacter(char)
        end
    end)
    table.insert(EspConnections, charConn)
    
    -- Setup inicial
    if player.Character then
        SetupCharacter(player.Character)
    end
end

local function StartEsp()
    print("[ESP] Iniciando sistema...")
    
    for _, conn in ipairs(EspConnections) do
        conn:Disconnect()
    end
    EspConnections = {}
    
    -- Criar ESP para todos os players atuais
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            CreateEspForPlayer(plr)
        end
    end
    
    -- Conectar novos players
    local addedConn = Players.PlayerAdded:Connect(function(plr)
        if plr ~= LocalPlayer then
            print("[ESP] Novo player detectado: " .. plr.Name)
            CreateEspForPlayer(plr)
        end
    end)
    table.insert(EspConnections, addedConn)
    
    -- Remover ESP quando player sair
    local removingConn = Players.PlayerRemoving:Connect(function(plr)
        if EspBillboards[plr] then
            pcall(function()
                EspBillboards[plr]:Destroy()
            end)
            EspBillboards[plr] = nil
            print("[ESP] Removido: " .. plr.Name)
        end
    end)
    table.insert(EspConnections, removingConn)
    
    -- LOOP CONTINUO: Verificar a cada frame se todos tem ESP
    if EspUpdateConnection then EspUpdateConnection:Disconnect() end
    
    EspUpdateConnection = RunService.Heartbeat:Connect(function()
        if not EspEnabled then return end
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local Head = plr.Character:FindFirstChild("Head")
                if Head then
                    local HasEsp = Head:FindFirstChild("EspBillboard")
                    if not HasEsp then
                        -- Recriar ESP se sumiu (respawn, reset, etc)
                        print("[ESP] Recriando ESP para " .. plr.Name .. " (sumiu)")
                        local function SetupCharacter(character)
                            if not character then return end
                            local NewHead = character:WaitForChild("Head", 2)
                            if not NewHead then return end
                            
                            local OldEsp = NewHead:FindFirstChild("EspBillboard")
                            if OldEsp then OldEsp:Destroy() end
                            
                            local Billboard = Instance.new("BillboardGui")
                            Billboard.Name = "EspBillboard"
                            Billboard.AlwaysOnTop = true
                            Billboard.Size = UDim2.new(0, 120, 0, 30)
                            Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
                            Billboard.Adornee = NewHead
                            Billboard.Parent = NewHead
                            
                            local Label = Instance.new("TextLabel")
                            Label.Name = "NameLabel"
                            Label.BackgroundTransparency = 1
                            Label.Size = UDim2.new(1, 0, 1, 0)
                            Label.Text = plr.Name
                            Label.TextColor3 = plr.Team and plr.TeamColor.Color or Color3.fromRGB(0, 255, 100)
                            Label.TextStrokeTransparency = 0.3
                            Label.TextStrokeColor3 = Color3.new(0, 0, 0)
                            Label.TextScaled = true
                            Label.FontFace = Library.Scheme.Font
                            Label.Parent = Billboard
                            
                            EspBillboards[plr] = Billboard
                        end
                        SetupCharacter(plr.Character)
                    end
                end
            end
        end
    end)
    
    print("[ESP] Sistema ativo - monitorando " .. (#Players:GetPlayers() - 1) .. " players")
end

local function StopEsp()
    if EspUpdateConnection then
        EspUpdateConnection:Disconnect()
        EspUpdateConnection = nil
    end
    
    for _, conn in ipairs(EspConnections) do
        conn:Disconnect()
    end
    EspConnections = {}
    
    for player, billboard in pairs(EspBillboards) do
        pcall(function()
            if billboard and billboard.Parent then
                billboard:Destroy()
            end
        end)
    end
    EspBillboards = {}
    
    print("[ESP] Desativado")
end

