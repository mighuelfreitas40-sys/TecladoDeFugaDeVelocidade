-- FUNCAO Remove Lava
local function StartRemoveLava()
    if LavaConnection then LavaConnection:Disconnect() end
    
    local LavaFolder = Workspace:FindFirstChild("Lava")
    if LavaFolder then
        for _, obj in ipairs(LavaFolder:GetDescendants()) do
            pcall(function()
                if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
                    obj:Destroy()
                end
            end)
        end
    end
    
    LavaConnection = RunService.Heartbeat:Connect(function()
        if not RemoveLavaEnabled then return end
        
        local Lava = Workspace:FindFirstChild("Lava")
        if not Lava then return end
        
        for _, obj in ipairs(Lava:GetDescendants()) do
            pcall(function()
                if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
                    if obj.Parent then
                        obj:Destroy()
                    end
                end
            end)
        end
    end)
end

local function StopRemoveLava()
    if LavaConnection then
        LavaConnection:Disconnect()
        LavaConnection = nil
    end
end

